#!/usr/bin/env python3
"""
Continuous Acoustic Envelope TRF Analysis

This uses the standard approach from literature (Di Liberto et al., 2015):
- Continuous acoustic envelope (RMS or Hilbert)
- No sparse impulses
- No normalization issues
- Should work for natural conversation

This is the gold standard approach that should show signal if it exists.
"""

import argparse
from pathlib import Path
import numpy as np
import pandas as pd
import mne
import eelbrain
import librosa
from scipy.signal import resample, hilbert
from scipy.interpolate import interp1d


def load_synchronized_audio(subject: str, run: int, base_dir: Path):
    """
    Load the external audio file that was synchronized with MEG.

    Returns
    -------
    audio : np.ndarray
        Audio waveform
    sr : int
        Sample rate
    sync_offset : float
        Offset in seconds from sync
    """
    # Find external audio file
    audio_pattern = f"G*_P{subject[-2:]}_0{run}.wav"

    # Common locations
    possible_paths = [
        Path("/Users/em18033/Library/CloudStorage/OneDrive-AUTUniversity/Projects/Conversational_AI/Archive/data/audios") / audio_pattern,
        base_dir / "data" / "audio" / audio_pattern,
    ]

    audio_file = None
    for pattern_path in possible_paths:
        matches = list(pattern_path.parent.glob(pattern_path.name))
        if matches:
            audio_file = matches[0]
            break

    if audio_file is None:
        raise FileNotFoundError(f"Could not find audio file matching {audio_pattern}")

    print(f"  Loading audio: {audio_file}")
    audio, sr = librosa.load(audio_file, sr=None)

    # Load sync parameters
    sync_dir = base_dir / "outputs" / "sync" / subject / f"run-{run:02d}"
    sync_params_file = sync_dir / "sync_params.json"

    if not sync_params_file.exists():
        raise FileNotFoundError(f"Sync params not found: {sync_params_file}")

    import json
    with open(sync_params_file, 'r') as f:
        sync_params = json.load(f)
    sync_offset = sync_params['initial_offset_s']

    print(f"  Audio: {len(audio)/sr:.1f}s @ {sr} Hz")
    print(f"  Sync offset: {sync_offset:.3f}s")

    return audio, sr, sync_offset


def compute_acoustic_envelope(audio, sr, method='rms', frame_length=None, hop_length=None):
    """
    Compute acoustic envelope using standard methods.

    Parameters
    ----------
    audio : np.ndarray
        Audio waveform
    sr : int
        Sample rate
    method : str
        'rms' or 'hilbert'
    frame_length : int
        Frame length for RMS (default: 25ms)
    hop_length : int
        Hop length for RMS (default: 10ms)

    Returns
    -------
    envelope : np.ndarray
        Acoustic envelope
    envelope_times : np.ndarray
        Time points for envelope samples
    envelope_sr : float
        Effective sample rate of envelope
    """
    if frame_length is None:
        frame_length = int(0.025 * sr)  # 25ms
    if hop_length is None:
        hop_length = int(0.010 * sr)    # 10ms (100 Hz)

    print(f"\nComputing {method} envelope...")
    print(f"  Frame length: {frame_length/sr*1000:.1f}ms")
    print(f"  Hop length: {hop_length/sr*1000:.1f}ms")

    if method == 'rms':
        # Root mean square energy
        envelope = librosa.feature.rms(
            y=audio,
            frame_length=frame_length,
            hop_length=hop_length
        )[0]

    elif method == 'hilbert':
        # Hilbert envelope (analytic signal amplitude)
        analytic_signal = hilbert(audio)
        full_envelope = np.abs(analytic_signal)

        # Downsample to ~100 Hz
        envelope = full_envelope[::hop_length]

    else:
        raise ValueError(f"Unknown method: {method}")

    # Create time vector for envelope
    envelope_times = np.arange(len(envelope)) * hop_length / sr
    envelope_sr = sr / hop_length

    print(f"  Envelope: {len(envelope)} samples @ {envelope_sr:.1f} Hz")
    print(f"  Duration: {envelope_times.max():.1f}s")

    return envelope, envelope_times, envelope_sr


def align_envelope_to_meg(envelope, envelope_times, sync_offset, meg_times):
    """
    Align acoustic envelope to MEG time base.

    Parameters
    ----------
    envelope : np.ndarray
        Acoustic envelope
    envelope_times : np.ndarray
        Time points for envelope (in audio time)
    sync_offset : float
        Offset from synchronization (seconds)
    meg_times : np.ndarray
        MEG time points

    Returns
    -------
    envelope_meg : np.ndarray
        Envelope resampled to MEG time base
    """
    # Adjust envelope times to MEG timebase
    # Positive offset means external starts AFTER MEG, so ADD offset
    envelope_times_meg = envelope_times + sync_offset

    print(f"\nAligning envelope to MEG...")
    print(f"  Envelope MEG time range: {envelope_times_meg.min():.1f}s to {envelope_times_meg.max():.1f}s")
    print(f"  MEG time range: {meg_times.min():.1f}s to {meg_times.max():.1f}s")

    # Interpolate envelope to MEG sampling rate
    interp_func = interp1d(
        envelope_times_meg,
        envelope,
        kind='linear',
        bounds_error=False,
        fill_value=0  # Fill with 0 outside range
    )

    envelope_meg = interp_func(meg_times)

    # Check how much data is valid
    valid_samples = np.sum((meg_times >= envelope_times_meg.min()) &
                           (meg_times <= envelope_times_meg.max()))
    valid_pct = 100 * valid_samples / len(meg_times)

    print(f"  Valid MEG samples: {valid_samples}/{len(meg_times)} ({valid_pct:.1f}%)")
    print(f"  Envelope stats: mean={envelope_meg.mean():.6f}, max={envelope_meg.max():.6f}")

    return envelope_meg


def envelope_trf_analysis(subject: str, run: int, meg_raw: mne.io.Raw,
                          base_dir: Path, sensor_type: str = 'mag',
                          envelope_method: str = 'rms'):
    """
    Fit TRF using continuous acoustic envelope.

    This is the standard approach from literature.
    """
    print("="*70)
    print("CONTINUOUS ENVELOPE TRF ANALYSIS")
    print("="*70)
    print(f"\nSubject: {subject}, Run: {run}")
    print(f"Sensor type: {sensor_type}")
    print(f"Envelope method: {envelope_method}")

    # 1. Load synchronized audio
    print("\n" + "="*70)
    print("LOADING SYNCHRONIZED AUDIO")
    print("="*70)

    audio, audio_sr, sync_offset = load_synchronized_audio(subject, run, base_dir)

    # 2. Compute acoustic envelope
    print("\n" + "="*70)
    print("COMPUTING ACOUSTIC ENVELOPE")
    print("="*70)

    envelope, envelope_times, envelope_sr = compute_acoustic_envelope(
        audio, audio_sr, method=envelope_method
    )

    # 3. Load MEG data
    print("\n" + "="*70)
    print("LOADING MEG DATA")
    print("="*70)

    picks = mne.pick_types(meg_raw.info, meg=sensor_type, eeg=(sensor_type=='eeg'),
                           exclude='bads')
    meg_data, meg_times = meg_raw[picks, :]
    meg_sfreq = meg_raw.info['sfreq']

    print(f"  Sensors: {len(picks)} {sensor_type}")
    print(f"  Duration: {meg_times.max():.1f}s")
    print(f"  Sampling rate: {meg_sfreq:.0f} Hz")

    # 4. Align envelope to MEG
    envelope_meg = align_envelope_to_meg(envelope, envelope_times, sync_offset, meg_times)

    # 5. Convert to eelbrain format
    print("\n" + "="*70)
    print("CONVERTING TO EELBRAIN FORMAT")
    print("="*70)

    time_dim = eelbrain.UTS(0, 1/meg_sfreq, meg_data.shape[1])

    ch_info = mne.pick_info(meg_raw.info, picks)
    try:
        sensor_dim = eelbrain.load.mne.sensor_dim(ch_info)
        print("  Using eelbrain sensor dimension")
    except (AttributeError, TypeError):
        print("  Using simple sensor indexing...")
        sensor_dim = eelbrain.Case

    meg_ndvar = eelbrain.NDVar(
        meg_data,
        dims=(sensor_dim, time_dim),
        info={'subject': subject},
        name='MEG'
    )

    envelope_ndvar = eelbrain.NDVar(
        envelope_meg,
        dims=(time_dim,),
        name='Acoustic Envelope'
    )

    print(f"  MEG shape: {meg_ndvar.shape}")
    print(f"  Envelope shape: {envelope_ndvar.shape}")

    # 6. Fit TRF
    print("\n" + "="*70)
    print("FITTING TRF MODEL")
    print("="*70)

    print("\nFitting TRF with acoustic envelope predictor...")
    print("  This may take 5-10 minutes...")

    trf = eelbrain.boosting(
        meg_ndvar,
        envelope_ndvar,
        tstart=-0.1,      # -100ms before stimulus
        tstop=0.5,        # +500ms after stimulus
        scale_data=True,  # Z-score both MEG and envelope
        delta=0.005,      # 5ms TRF resolution
        mindelta=0.0005,  # Minimum delta for convergence
        error='l1',       # L1 error (robust to outliers)
    )

    print("\n✓ TRF fitting complete!")
    print(f"  Model correlation: {trf.r.mean():.4f}")
    print(f"  Max correlation: {trf.r.max():.4f}")

    # 7. Save results
    print("\n" + "="*70)
    print("SAVING RESULTS")
    print("="*70)

    output_dir = base_dir / "outputs" / "trf_envelope" / subject / f"run-{run:02d}"
    output_dir.mkdir(parents=True, exist_ok=True)

    # Save TRF model
    import pickle
    with open(output_dir / "trf_model.pkl", 'wb') as f:
        pickle.dump(trf, f)
    print(f"✓ Saved: {output_dir / 'trf_model.pkl'}")

    # Save envelope
    np.save(output_dir / "envelope_meg.npy", envelope_meg)
    print(f"✓ Saved: {output_dir / 'envelope_meg.npy'}")

    # Save summary
    summary = {
        'subject': subject,
        'run': run,
        'sensor_type': sensor_type,
        'envelope_method': envelope_method,
        'n_sensors': len(picks),
        'duration_s': float(meg_times.max()),
        'envelope_sr_hz': float(envelope_sr),
        'model_correlation_mean': float(trf.r.mean()),
        'model_correlation_max': float(trf.r.max()),
    }

    import json
    with open(output_dir / "summary.json", 'w') as f:
        json.dump(summary, f, indent=2)
    print(f"✓ Saved: {output_dir / 'summary.json'}")

    # Try to create simple plots
    try:
        import matplotlib.pyplot as plt

        # Plot envelope
        fig, axes = plt.subplots(2, 1, figsize=(12, 8))

        # Envelope waveform
        plot_duration = min(10, meg_times.max())  # Plot first 10s
        plot_mask = meg_times <= plot_duration

        axes[0].plot(meg_times[plot_mask], envelope_meg[plot_mask], linewidth=0.5)
        axes[0].set_xlabel('Time (s)')
        axes[0].set_ylabel('Envelope amplitude')
        axes[0].set_title('Acoustic Envelope (first 10s)')
        axes[0].grid(True, alpha=0.3)

        # Envelope histogram
        axes[1].hist(envelope_meg[envelope_meg > 0], bins=50, edgecolor='black', alpha=0.7)
        axes[1].set_xlabel('Envelope amplitude')
        axes[1].set_ylabel('Count')
        axes[1].set_title('Envelope Distribution')
        axes[1].grid(True, alpha=0.3)

        plt.tight_layout()
        fig.savefig(output_dir / 'envelope_diagnostic.png', dpi=150, bbox_inches='tight')
        print(f"✓ Saved: {output_dir / 'envelope_diagnostic.png'}")
        plt.close(fig)

    except Exception as e:
        print(f"  Warning: Could not create diagnostic plots: {e}")

    print("\n" + "="*70)
    print("ENVELOPE TRF COMPLETE!")
    print("="*70)
    print(f"\nResults: {output_dir}")
    print(f"\nModel performance:")
    print(f"  Mean correlation: {trf.r.mean():.4f}")
    print(f"  Max correlation: {trf.r.max():.4f}")

    if trf.r.max() > 0.05:
        print("\n✅ SUCCESS! Envelope TRF shows signal!")
        print("  This validates the approach - acoustic envelope drives MEG")
    elif trf.r.max() > 0.01:
        print("\n⚠ Weak but non-zero correlation")
        print("  May need more data or parameter tuning")
    else:
        print("\n❌ No signal detected")
        print("  Check: sync alignment, MEG preprocessing, or data quality")

    return {
        'trf': trf,
        'summary': summary,
        'envelope_meg': envelope_meg,
        'meg_ndvar': meg_ndvar,
        'envelope_ndvar': envelope_ndvar,
    }


def main():
    parser = argparse.ArgumentParser(description="Continuous envelope TRF analysis")
    parser.add_argument("--subject", required=True, help="Subject ID")
    parser.add_argument("--run", type=int, required=True, help="Run number")
    parser.add_argument("--meg-file", required=True, help="Path to MEG file")
    parser.add_argument("--audio-file", help="Path to audio file (if not specified, will search automatically)")
    parser.add_argument("--sensor-type", default="mag",
                       choices=['mag', 'grad', 'eeg'],
                       help="Sensor type")
    parser.add_argument("--envelope-method", default="rms",
                       choices=['rms', 'hilbert'],
                       help="Envelope extraction method")
    parser.add_argument("--base-dir", type=Path,
                       default=Path("/Users/em18033/Library/CloudStorage/OneDrive-AUTUniversity/Projects/turn-taking-pipeline"),
                       help="Pipeline base directory")

    args = parser.parse_args()

    # Load MEG data
    print(f"Loading MEG data from: {args.meg_file}")
    meg_raw = mne.io.read_raw_fif(args.meg_file, preload=True, verbose=False)

    # Run analysis
    # Override the load_synchronized_audio function if audio file is provided
    if args.audio_file:
        # Monkey patch to use provided audio file
        def load_audio_override(subject, run, base_dir):
            print(f"  Loading audio: {args.audio_file}")
            import librosa
            audio, sr = librosa.load(args.audio_file, sr=None)

            # Get sync offset
            sync_dir = base_dir / "outputs" / "sync" / subject / f"run-{run:02d}"
            sync_params_file = sync_dir / "sync_params.json"

            if sync_params_file.exists():
                import json
                with open(sync_params_file, 'r') as f:
                    sync_params = json.load(f)
                sync_offset = sync_params['initial_offset_s']
            else:
                print("  Warning: No sync params found, using offset=0")
                sync_offset = 0.0

            print(f"  Audio: {len(audio)/sr:.1f}s @ {sr} Hz")
            print(f"  Sync offset: {sync_offset:.3f}s")
            return audio, sr, sync_offset

        # Replace the function
        import sys
        current_module = sys.modules[__name__]
        original_func = load_synchronized_audio
        setattr(current_module, 'load_synchronized_audio', load_audio_override)

    results = envelope_trf_analysis(
        args.subject,
        args.run,
        meg_raw,
        args.base_dir,
        args.sensor_type,
        args.envelope_method
    )

    print("\n✓ Analysis complete!")


if __name__ == "__main__":
    main()
